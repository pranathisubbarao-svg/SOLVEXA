# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/solvexa?retryWrites=true&w=majority

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Google sign-in (OAuth Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Email for staff approval / rejection (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SOLVEXA <you@gmail.com>

# Address of the website, used in email links
CLIENT_URL=http://localhost:5173
